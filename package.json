{
  "name": "sentinellab",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm --filter @sentinellab/api run test:integration",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @sentinellab/api exec prisma migrate deploy"
  }
}
