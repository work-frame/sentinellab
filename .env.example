# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# PostgreSQL (docker compose reads these too)
POSTGRES_USER=sentinellab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sentinellab
DATABASE_URL=postgresql://sentinellab:change-me-local-only@localhost:5432/sentinellab?schema=public
# Integration tests use this database; it is created if missing and must end in _test.
# TEST_DATABASE_URL=postgresql://sentinellab:change-me-local-only@localhost:5432/sentinellab_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379
# QUEUE_PREFIX=sentinellab-development

# API
API_PORT=4000
# Origin(s) of the web app, comma separated. Used for CORS and the CSRF Origin check.
WEB_ORIGIN=http://localhost:3000
# true when the API is served over HTTPS (production). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
# SESSION_TTL_HOURS=12
# ALLOW_REGISTRATION=true
# SWAGGER_ENABLED=true
# Only set when a reverse proxy you control overwrites X-Forwarded-For, e.g. "loopback".
# TRUST_PROXY=
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=5

# Scanner
# Local demo targets, "key=url" pairs. Their exact host:port become the only local addresses the scanner may reach.
# DEMO_TARGETS=vulnerable-web=http://localhost:8081/,vulnerable-api=http://localhost:8082/
# Extra host:port pairs allowed to resolve to private addresses. Leave empty unless you know why you need it.
# SCANNER_PRIVATE_ALLOWLIST=
# SCAN_REQUEST_TIMEOUT_MS=10000

# Web (baked into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
