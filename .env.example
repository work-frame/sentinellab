# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=sentinellab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sentinellab
DATABASE_URL=postgresql://sentinellab:change-me-local-only@localhost:5432/sentinellab?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Origin of the web app, used for CORS and CSRF origin checks
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
